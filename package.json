{
  "name": "hyperborea",
  "productName": "HYPERBOREA",
  "version": "1.1.0",
  "description": "HYPERBOREA DATABASE — приложение для ПК",
  "main": "main.js",
  "private": true,
  "scripts": {
    "copy-site": "node scripts/copy-site.mjs",
    "start": "electron .",
    "build": "node scripts/copy-site.mjs && electron-builder --win nsis",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "site.hyperborea.app",
    "productName": "HYPERBOREA",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "site",
        "to": "site"
      }
    ],
    "win": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "HYPERBOREA",
      "artifactName": "HYPERBOREA-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Ewjpg",
      "repo": "hyperborea-app",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
