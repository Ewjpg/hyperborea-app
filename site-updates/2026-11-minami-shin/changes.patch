-.swarggy-cell::before,.swarggy-cell::after{content:'';position:absolute;pointer-events:none;width:11px;height:11px;border-color:#7da99b8f;border-style:solid}.swarggy-cell::before{left:-1px;top:-1px;border-width:1px 0 0 1px}.swarggy-cell::after{right:-1px;bottom:-1px;border-width:0 1px 1px 0}
