+.minami-intro-moon{position:absolute;left:50%;top:44%;width:min(70vmin,700px);aspect-ratio:1;border-radius:50%;transform:translate(-50%,-50%) scale(.55);background:radial-gradient(circle,#a1102a 0%,#640918 46%,#2c040c 69%,transparent 70%);opacity:0}
+.minami-intro-moon::after{content:'';position:absolute;inset:0;border-radius:50%;background-image:radial-gradient(circle,#080104 0 1.8px,transparent 2.3px);background-size:10px 10px;mask-image:linear-gradient(200deg,transparent 30%,#000 90%);-webkit-mask-image:linear-gradient(200deg,transparent 30%,#000 90%);opacity:.6}
+.minami-intro-bloom{position:absolute;z-index:2;left:50%;top:44%;width:min(118vmin,1100px);aspect-ratio:1;transform:translate(-50%,-50%);pointer-events:none}
+.minami-intro-bloom svg{display:block;width:100%;height:100%;overflow:visible}
+.minami-intro-kanji{position:absolute;z-index:3;right:clamp(22px,7vw,110px);top:50%;width:1em;color:#ff4258;font:400 clamp(46px,7.5vw,112px)/1.2 var(--minami-mincho);word-break:break-all;text-align:center;text-shadow:0 0 30px #ff284480;opacity:0;transform:translateY(-50%);pointer-events:none}
+.minami-intro-petals{--fall:115vh;z-index:3;opacity:0;transition:opacity .9s}
+.minami-intro-flash{position:absolute;z-index:4;inset:0;pointer-events:none;background:radial-gradient(circle at 50% 44%,#ff3a52 0%,#b3122b66 30%,transparent 68%);opacity:0;mix-blend-mode:screen}
+.swarggy-intro-label{position:absolute;z-index:5;left:clamp(24px,6vw,90px);bottom:max(42px,8vh);display:flex;flex-direction:column;align-items:flex-start;gap:11px;color:#c86f7b;font:9px/1.8 Arial,sans-serif;letter-spacing:.25em;text-shadow:0 2px 10px #000;opacity:0}
+.swarggy-intro-label strong{display:block;color:#ffe3e6;font:400 clamp(32px,5vw,68px)/1.1 Georgia,serif;letter-spacing:-.04em}
+.swarggy-intro-label>span:last-child{font-size:10px;color:#e0939d;letter-spacing:.28em}
+#swarggyIntroSkip{position:absolute;z-index:7;right:clamp(24px,5vw,70px);top:max(24px,env(safe-area-inset-top));display:flex;align-items:center;gap:25px;min-height:45px;padding:10px 16px;border:1px solid #a0303f80;background:#14050a80;color:#f0b3bb;font:9px/1.8 Arial,sans-serif;letter-spacing:.12em;cursor:pointer;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
+#swarggyIntroSkip:hover{border-color:#ff6b7c;background:#3a0a1490;color:#fff0f2}
+#swarggyIntroSkip[hidden]{display:none}
+.swarggy-intro.is-blooming .minami-intro-moon{animation:minami-moon 2.4s cubic-bezier(.2,.7,.2,1) .1s both}
+.swarggy-intro.is-blooming .minami-intro-kanji{animation:minami-kanji 1.3s cubic-bezier(.2,.7,.2,1) .95s both}
+.swarggy-intro.is-blooming .swarggy-intro-label{animation:minami-rise 1s cubic-bezier(.2,.7,.2,1) 1.1s both}
+.swarggy-intro.is-blooming .minami-intro-petals{opacity:1;transition-delay:.9s}
+.swarggy-intro.is-blooming .minami-intro-flash{animation:minami-pulse 1.1s ease-out .95s both}
+.swarggy-intro.is-finishing .minami-intro-flash{animation:minami-flash .85s ease-out both}
+.swarggy-intro.is-finishing .hb-stem{opacity:0;transition:opacity .25s}
+.swarggy-intro.is-finishing :is(.swarggy-intro-label,.minami-intro-kanji,#swarggyIntroSkip){opacity:0;transition:opacity .3s}
